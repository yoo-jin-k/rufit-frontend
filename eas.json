{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_RUFIT_API_URL": "https://api.rufit.yjinee.com",
        "EXPO_PUBLIC_RUFIT_KAKAO_ENABLED": "true",
        "EXPO_PUBLIC_RUFIT_GOOGLE_ENABLED": "true"
      }
    },
    "testflight": {
      "extends": "preview",
      "distribution": "store"
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6835021732"
      }
    }
  }
}
